{
  "name": "ci",
  "description": "ci/cd environment",
  "chef_type": "environment",
  "normal_attributes": {
    "nimbus-jenkins": {
      "master": {
        "host": "http://localhost/"
      },
      "init": {
        "envvars": {
          "AWS_DEFAULT_REGION": "local",
          "GEM_ROOT": "/opt/chefdk/embedded/lib/ruby/gems/2.5.0",
          "GEM_HOME": "/var/lib/jenkins/.chefdk/gem/ruby/2.5.0",
          "GEM_PATH": "/var/lib/jenkins/.chefdk/gem/ruby/2.5.0:/opt/chefdk/embedded/lib/ruby/gems/2.5.0",
          "PATH": "/usr/local/bin:/usr/bin:/usr/local/sbin:/opt/chefdk/bin:/opt/chefdk/embedded/bin:/usr/sbin:/sbin:/bin:/usr/bin",
          "PYTHONUNBUFFERED": "1",
          "BITBUCKET_URL": "git.nimbus.io:7999",
          "BUILD_ENV": "test-kitchen",
          "HOSTED_ZONE": "int.nimbus.io",
          "OA_ADADMIN": "service-agent@nimbus",
          "OA_PASS": "password"
        },
        "ldap": {
          "enable": "false"
        },
        "seedjobs": {
          "saaseng-seed-job": {
            "name": "saaseng-seed-job",
            "remote": "ssh://git@git.nimbus.io:7999/saaseng/nimbus-jenkins-jobs.git",
            "credentials": "saaseng-readonly",
            "branch": "master",
            "poll": "H H * 1-11 *",
            "periodic": "H H * 1-11 *",
            "pipeline": "seed/Jenkinsfile",
            "execute": "always"
          }
        },
        "sharedlibs": {
          "credentialsId": "saaseng-readonly",
          "sharedlib_version": "master",
          "url": "ssh://git@git.nimbus.io:7999/saaseng/nimbus-jenkins-shared-libraries.git"
        }
      },
